# Smart Waste Management - Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# Flask/App Settings
APP_ENV=production
HOST=0.0.0.0
PORT=5000
# Note: Deployment platforms (like Render) will override PORT dynamically.

# PostgreSQL Configuration
DB_HOST=<POSTGRES_HOST>
DB_PORT=5432
DB_NAME=<POSTGRES_DATABASE>
DB_USER=<POSTGRES_USER>
DB_PASSWORD=<POSTGRES_PASSWORD>

# Twilio WhatsApp Configuration
TWILIO_ACCOUNT_SID=<TWILIO_ACCOUNT_SID>
TWILIO_AUTH_TOKEN=<TWILIO_AUTH_TOKEN>
TWILIO_WHATSAPP_FROM=<TWILIO_WHATSAPP_FROM>
TWILIO_TO_WHATSAPP_NUMBER=<TWILIO_TO_WHATSAPP_NUMBER>

# CORS Configuration
# Comma-separated list of allowed origins. Use * for unrestricted local development.
CORS_ALLOWED_ORIGINS=<ALLOWED_ORIGIN_1>,<ALLOWED_ORIGIN_2>

# JWT Authentication Secret
JWT_SECRET_KEY=<LONG_RANDOM_RESIDENT_JWT_SECRET>

# Admin Authentication
ADMIN_USERNAME=<ADMIN_USERNAME>
ADMIN_PASSWORD=<STRONG_ADMIN_PASSWORD>
ADMIN_JWT_SECRET_KEY=<LONG_RANDOM_ADMIN_JWT_SECRET>
